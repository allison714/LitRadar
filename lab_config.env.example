# ==============================================================================
#                             LitRadar SUITE
#                    MEMBER CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions for New Users:
# 1. You can run '00_First_Time_Setup.bat' to automatically generate 'lab_config.env'.
# 2. Or copy this file to 'lab_config.env' and fill in your credentials below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MEMBER PROFILE
# ------------------------------------------------------------------------------
LAB_MEMBER_NAME=Your Full Name
LAB_MEMBER_EMAIL=your.name@university.edu

# Personal Gmail or inbox to RECEIVE weekly digests & alerts:
RECIPIENT_EMAIL=your.personal.email@gmail.com

# ------------------------------------------------------------------------------
# 2. EMAIL DISPATCH SETTINGS (Optional - for automated weekly email delivery)
# ------------------------------------------------------------------------------
# Requires a free 16-character Gmail App Password (myaccount.google.com/security)
SENDER_GMAIL=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 3. ZOTERO CLOUD INTEGRATION
# ------------------------------------------------------------------------------
# Find your User ID and generate an API Key at: https://www.zotero.org/settings/keys
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# Optional: Path to local zotero.sqlite for instant deduplication:
ZOTERO_LOCAL_DB=

# ------------------------------------------------------------------------------
# 4. STORAGE LOCATIONS
# ------------------------------------------------------------------------------
# Directory where downloaded full-text PDFs will be organized:
PDF_STORAGE_DIR=

# ------------------------------------------------------------------------------
# 5. SCIENTIFIC APIs & AI ENGINES (Optional)
# ------------------------------------------------------------------------------
NCBI_EMAIL=
NCBI_API_KEY=
GEMINI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# 6. SYSTEM RUNTIME
# ------------------------------------------------------------------------------
PYTHON_EXE=python
